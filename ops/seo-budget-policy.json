{
  "version": 1,
  "purpose": "Bounded twice-weekly SEO and AI-search growth run. This is a focused content-quality budget, not an open-ended acquisition loop.",
  "budget": {
    "max_worker_invocations_per_run": 8,
    "max_total_task_attempts_per_run": 8,
    "max_terra_medium_high_invocations_per_run": 3,
    "max_terra_xhigh_invocations_per_run": 0,
    "max_sol_invocations_per_run": 0,
    "max_runtime_per_task_minutes": 20,
    "max_total_runtime_minutes": 60,
    "max_full_regression_runs": 1,
    "max_consecutive_no_progress_attempts": 2,
    "finalization_reserve_invocations": 2,
    "max_new_pages": 2,
    "max_refreshes": 2
  },
  "retries": {
    "routine": 1,
    "standard": 1,
    "complex": 1,
    "high_risk": 0
  },
  "overrides": {
    "require_explicit_human_override": true,
    "environment_flag": "CODEX_QUEUE_ALLOW_BUDGET_OVERRIDE",
    "sol_environment_flag": "CODEX_QUEUE_ALLOW_SOL"
  },
  "context": {
    "stable_prompt_prefix": true,
    "task_scoped_context": true,
    "pass_full_parent_prompt": false,
    "checkpoint_summary_only": true,
    "max_failure_log_characters": 4000
  },
  "cache": {
    "optimize_native_prompt_cache": true,
    "track_cached_input_if_available": true,
    "custom_response_cache": false
  }
}
